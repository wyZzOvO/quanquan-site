---
/**
 * 关于半亩晴空（需求文档 FR15、17.2）：公司全称、与半拍的关系、产品定位、有效联系渠道。
 * 公司成为生效运营主体之前，只写"变更中、以协议为准"，不提前写运营者表述；不生成团队规模、融资、合作等未提供的事实。
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import CopyButton from '../../components/CopyButton.astro'
import { content } from '../../lib/content.ts'
import { staticPages } from '../../lib/pages.ts'
import { formatDateZh } from '../../lib/format.ts'

const page = staticPages(content).about
const { company, product } = content
const contacts = company.contacts.filter((c) => c.verified)
---

<BaseLayout
  seo={{
    path: page.path,
    title: page.title,
    description: page.description,
    keywords: page.keywords,
    ogImage: page.ogImage,
    ogImageAlt: page.ogImageAlt,
    breadcrumbs: [{ name: page.name, path: page.path }],
    pageType: 'AboutPage',
    about: 'organization',
    dateModified: page.updatedAt,
  }}
>
  <section class="intro">
    <div class="container-text center">
      <p class="eyebrow">关于我们</p>
      <h1 class="headline-page">关于半亩晴空</h1>
      <p class="lede intro-lede">{company.introduction}</p>
    </div>
  </section>

  <section class="section-tight bg-alt">
    <div class="container relation">
      <div class="relation-card" data-reveal>
        <p class="label">公司品牌</p>
        <p class="name">{company.brandName}</p>
        <p class="text-2">{company.legalName}</p>
      </div>
      <div class="relation-link" aria-hidden="true">→</div>
      <div class="relation-card" data-reveal="1">
        <p class="label">产品品牌</p>
        <p class="name">{product.name}</p>
        <p class="text-2">{product.shortDescription}</p>
      </div>
    </div>
    <div class="container-text center relation-text">
      <p>{company.relation}{product.definition}</p>
      <p class="operator">
        {company.operator.effective ? `半拍由${company.legalName}运营。` : company.operator.pendingNote}
      </p>
      {
        company.operator.effective ? null : (
          <p class="small text-2">
            查看<a href="/legal/user-agreement.html">《用户服务协议》</a>和<a href="/legal/privacy-policy.html">《隐私政策》</a>。
          </p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container-text">
      <h2 class="headline-section">公司信息</h2>
      <dl class="facts">
        <div>
          <dt>公司全称</dt>
          <dd>{company.legalName}</dd>
        </div>
        <div>
          <dt>公司品牌</dt>
          <dd>{company.brandName}</dd>
        </div>
        {
          company.display.creditCode ? (
            <div>
              <dt>统一社会信用代码</dt>
              <dd>
                <span class="mono">{company.unifiedSocialCreditCode}</span>
                <span class="small text-2 verify">
                  可在<a href="https://www.gsxt.gov.cn/">国家企业信用信息公示系统</a>核验
                </span>
              </dd>
            </div>
          ) : null
        }
        {
          company.display.foundedAt ? (
            <div>
              <dt>成立日期</dt>
              <dd>
                <time datetime={company.foundedAt}>{formatDateZh(company.foundedAt)}</time>
              </dd>
            </div>
          ) : null
        }
        <div>
          <dt>登记所在地</dt>
          <dd>{company.registeredRegion}</dd>
        </div>
        <div>
          <dt>主要产品</dt>
          <dd><a href="/">{product.name}</a>：线上找游戏搭子、查看队伍与语音开黑</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section bg-alt" id="contact">
    <div class="container-text">
      <h2 class="headline-section">联系我们</h2>
      <ul class="contacts">
        {
          contacts.map((c) => (
            <li>
              <p class="contact-label">{c.label}</p>
              <p class="contact-value">
                <a href={`mailto:${c.value}`}>{c.value}</a>
              </p>
              {c.note ? <p class="small text-2">{c.note}</p> : null}
              <CopyButton value={c.value} label="复制邮箱" />
            </li>
          ))
        }
      </ul>
      <p class="small text-2 contact-tip">
        使用问题、投诉举报与个人信息请求，也可以先查看<a href="/support/">帮助与支持</a>。发邮件时请不要附上密码、验证码或完整的聊天记录。
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 56px 0 48px;
  }

  @media (min-width: 734px) {
    .intro {
      padding: 88px 0 64px;
    }
  }

  .intro-lede {
    max-width: 30em;
    margin: 18px auto 0;
  }

  .relation {
    display: grid;
    gap: 16px;
    align-items: center;
  }

  @media (min-width: 734px) {
    .relation {
      grid-template-columns: 1fr auto 1fr;
      gap: 24px;
    }
  }

  .relation-card {
    padding: 32px;
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .label {
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .name {
    margin: 4px 0 6px;
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
  }

  .relation-link {
    color: var(--text-2);
    font-size: 28px;
    text-align: center;
  }

  @media (max-width: 733px) {
    .relation-link {
      transform: rotate(90deg);
    }
  }

  .relation-text {
    margin-top: 40px;
  }

  .relation-text p + p {
    margin-top: 12px;
  }

  .operator {
    font-weight: 600;
  }

  .facts {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    grid-template-columns: 8.5em 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 480px) {
    .facts div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .facts dt {
    color: var(--text-2);
  }

  .mono {
    font-family: var(--mono);
    letter-spacing: 0.02em;
  }

  .verify {
    display: block;
    margin-top: 2px;
  }

  .contacts {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    list-style: none;
  }

  @media (min-width: 734px) {
    .contacts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contacts li {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: 26px;
    border-radius: var(--radius-card);
    background: var(--bg);
  }

  .contact-label {
    color: var(--text-2);
    font-size: 14px;
  }

  .contact-value {
    font-size: 19px;
    font-weight: 600;
    word-break: break-all;
  }

  .contact-tip {
    margin-top: 24px;
  }
</style>
