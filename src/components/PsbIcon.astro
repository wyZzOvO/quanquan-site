---
/**
 * 公安联网备案图标：本站自制的简单示意图形（盾牌 + 星），不使用、也不外链全国互联网安全管理服务平台的官方图片。
 * 只作装饰（aria-hidden），读屏读旁边的备案号文字；颜色跟随文字（currentColor），深浅背景都清楚。
 * 属地要求必须用官方图标时，把平台下载的图标放在本站托管后替换这里，仍然不要外链。
 */
interface Props {
  /** 边长（像素） */
  size?: number
}

const { size = 14 } = Astro.props
---

<svg class="psb-icon" viewBox="0 0 16 16" width={size} height={size} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <path
    d="M8 1.3 2.8 3.1v4.1c0 3.2 2.2 5.9 5.2 7.4 3-1.5 5.2-4.2 5.2-7.4V3.1L8 1.3Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linejoin="round"></path>
  <path d="M8 4.8 8.71 6.73 10.76 6.8 9.14 8.07 9.7 10.05 8 8.9 6.3 10.05 6.86 8.07 5.24 6.8 7.29 6.73Z" fill="currentColor"
  ></path>
</svg>

<style>
  .psb-icon {
    flex: none;
  }
</style>
