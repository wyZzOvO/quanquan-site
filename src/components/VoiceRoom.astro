---
/**
 * 队伍语音的界面示意（深色区块用）。用 HTML 重绘网页版语音面板的结构：成员、说话状态、开关麦、设备、退出，
 * 演示数据，不含真实用户；说话光圈只在进入视口后跳动几次（有限次装饰动画），减弱动效时不动。
 */
const members = [
  { name: '小鹿', initial: '鹿', tone: 'violet', mic: true, speaking: true, me: true },
  { name: '猎人老王', initial: '王', tone: 'green', mic: true, speaking: false, me: false },
  { name: '咕咕', initial: '咕', tone: 'indigo', mic: true, speaking: true, me: false },
  { name: '阿澈', initial: '澈', tone: 'amber', mic: false, speaking: false, me: false },
]
---

<div class="voice-card" data-reveal role="img" aria-label="队伍语音界面示意：4 位成员在语音中，其中两位正在说话，下方是开麦、设备与退出按钮">
  <div class="head">
    <div>
      <p class="label">队伍语音</p>
      <p class="title">今晚 20:30 黑蚀龙｜PS5｜欢迎新手</p>
    </div>
    <span class="live"><span class="dot"></span>4 人在语音</span>
  </div>
  <ul class="members">
    {
      members.map((m) => (
        <li class:list={['member', { speaking: m.speaking }]}>
          <span class:list={['avatar', `tone-${m.tone}`]}>{m.initial}</span>
          <span class="name">
            {m.name}
            {m.me ? <span class="me">（我）</span> : null}
          </span>
          <span class:list={['mic', { off: !m.mic }]}>
            {m.mic ? (
              <svg viewBox="0 0 24 24">
                <rect x="9" y="3" width="6" height="11" rx="3" />
                <path d="M6 11a6 6 0 0 0 12 0M12 17v4" fill="none" stroke-width="2" stroke-linecap="round" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24">
                <rect x="9" y="3" width="6" height="11" rx="3" />
                <path d="M6 11a6 6 0 0 0 12 0M12 17v4M4 4l16 16" fill="none" stroke-width="2" stroke-linecap="round" />
              </svg>
            )}
            {m.mic ? '开麦' : '静音'}
          </span>
        </li>
      ))
    }
  </ul>
  <div class="controls">
    <span class="ctrl primary">
      <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path
          d="M6 11a6 6 0 0 0 12 0M12 17v4"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"></path></svg
      >
      麦克风已开
    </span>
    <span class="ctrl">设备</span>
    <span class="ctrl danger">退出语音</span>
  </div>
</div>

<style>
  .voice-card {
    width: min(100%, 520px);
    margin-inline: auto;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: linear-gradient(160deg, rgba(123, 97, 255, 0.18), rgba(23, 21, 31, 0.9) 45%), var(--bg-dark-2);
    box-shadow:
      0 40px 90px -30px rgba(123, 97, 255, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    color: var(--text-on-dark);
    text-align: left;
  }

  @media (min-width: 734px) {
    .voice-card {
      padding: 28px;
    }
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .label {
    color: var(--accent-on-dark);
    font-size: 13px;
    font-weight: 600;
  }

  .title {
    margin-top: 2px;
    font-size: 17px;
    font-weight: 600;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(52, 199, 89, 0.14);
    color: #7ee2a0;
    font-size: 13px;
    font-weight: 600;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34c759;
  }

  .members {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
    list-style: none;
  }

  .member {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 18px 8px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
  }

  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    color: #fff;
    font-size: 20px;
    font-weight: 600;
  }

  .tone-violet {
    background: #6a4ff5;
  }

  .tone-green {
    background: #3a8f4f;
  }

  .tone-indigo {
    background: #4c3a9e;
  }

  .tone-amber {
    background: #b0731d;
  }

  .speaking .avatar {
    box-shadow:
      0 0 0 3px var(--bg-dark-2),
      0 0 0 5px #34c759;
  }

  :global(.reveal-in) .speaking .avatar::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid #34c759;
    animation: speak 1.4s ease-out 4;
    opacity: 0;
  }

  .member:nth-child(3) .avatar::after {
    animation-delay: 0.5s;
  }

  @keyframes speak {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  .name {
    font-size: 15px;
    font-weight: 600;
  }

  .me {
    color: var(--text-on-dark-2);
    font-weight: 400;
  }

  .mic {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #7ee2a0;
    font-size: 12px;
  }

  .mic.off {
    color: var(--text-on-dark-2);
  }

  .mic svg,
  .ctrl svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    stroke: currentColor;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .ctrl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 14px;
    font-weight: 600;
  }

  .ctrl.primary {
    background: var(--accent-ink);
  }

  .ctrl.danger {
    margin-left: auto;
    background: rgba(255, 69, 58, 0.16);
    color: #ff8a80;
  }
</style>
