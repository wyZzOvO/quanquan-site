---
/**
 * 手机外框 + 产品截图（需求文档 10.3：自制简化轮廓，不用 Apple 的设备图）。
 * 截图在 src/assets/screens（430 × 878 逻辑像素的 3 倍图），构建时生成 AVIF / WebP 多尺寸；
 * 外框上方补一条自制状态栏，与截图合起来是 430 × 932 的屏幕比例。
 */
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

const screens = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true })

interface Props {
  screen: string
  alt: string
  size?: 'lg' | 'md' | 'sm'
  /** 首屏主图：立即加载、提高优先级 */
  priority?: boolean
  class?: string
}

const { screen, alt, size = 'md', priority = false, class: className } = Astro.props
const mod = screens[`../assets/screens/${screen}.png`]
if (!mod) {
  throw new Error(`没有找到截图 src/assets/screens/${screen}.png`)
}
const sizes = {
  lg: '(min-width: 734px) 300px, 64vw',
  md: '(min-width: 734px) 270px, 60vw',
  sm: '(min-width: 734px) 230px, 52vw',
}[size]
---

<div class:list={['phone', `phone-${size}`, className]}>
  <div class="frame">
    <div class="screen">
      <div class="status" aria-hidden="true">
        <span class="time">9:41</span>
        <span class="island"></span>
        <span class="icons">
          <svg viewBox="0 0 18 12" class="signal"
            ><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"
            ></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"
            ></rect></svg
          >
          <svg viewBox="0 0 16 12" class="wifi"
            ><path
              d="M8 2.2c2.4 0 4.6.9 6.3 2.5l1.3-1.4A10.9 10.9 0 0 0 8 .2 10.9 10.9 0 0 0 .4 3.3l1.3 1.4A8.9 8.9 0 0 1 8 2.2Zm0 3.7c1.4 0 2.7.5 3.7 1.4l1.3-1.4A7.5 7.5 0 0 0 8 3.9a7.5 7.5 0 0 0-5 2l1.3 1.4c1-.9 2.3-1.4 3.7-1.4Zm0 3.6c.5 0 1 .2 1.3.5L8 11.6 6.7 10c.3-.3.8-.5 1.3-.5Z"
            ></path></svg
          >
          <svg viewBox="0 0 27 13" class="battery"
            ><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke-opacity="0.4"></rect><rect
              x="2.5"
              y="2.5"
              width="19"
              height="8"
              rx="2"></rect><path d="M25 4.5v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2Z" fill-opacity="0.45"></path></svg
          >
        </span>
      </div>
      <Picture
        src={mod.default}
        alt={alt}
        widths={[300, 450, 600, 900]}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={78}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .phone {
    --phone-w: min(270px, 60vw);
    width: var(--phone-w);
    flex: 0 0 auto;
  }

  .phone-lg {
    --phone-w: min(300px, 64vw);
  }

  .phone-sm {
    --phone-w: min(230px, 52vw);
  }

  .frame {
    position: relative;
    padding: calc(var(--phone-w) * 0.032);
    border-radius: calc(var(--phone-w) * 0.165);
    background: linear-gradient(150deg, #34333b 0%, #16151b 55%, #2a2930 100%);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.14),
      0 2px 4px rgba(22, 22, 30, 0.1),
      0 32px 64px -20px rgba(40, 26, 110, 0.32);
  }

  .screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 430 / 932;
    border-radius: calc(var(--phone-w) * 0.135);
    background: #fff;
  }

  .status {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5.794%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7.5% 0 9.5%;
    background: #fff;
    color: #16161e;
  }

  .time {
    font-size: calc(var(--phone-w) * 0.037);
    font-weight: 600;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .island {
    position: absolute;
    top: 20%;
    left: 50%;
    width: 29%;
    height: 64%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050507;
  }

  .icons {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--phone-w) * 0.012);
  }

  .icons svg {
    height: calc(var(--phone-w) * 0.026);
    width: auto;
    fill: currentColor;
    stroke: currentColor;
  }

  .icons .signal,
  .icons .wifi {
    stroke: none;
  }

  /* 截图区：430 × 878，正好填满状态栏以下的部分 */
  .screen :global(picture) {
    position: absolute;
    top: 5.794%;
    left: 0;
    width: 100%;
    height: 94.206%;
  }

  .screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
