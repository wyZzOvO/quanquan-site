{
  "name": "quanquan-site",
  "private": true,
  "version": "1.0.0",
  "description": "半亩晴空 / 半拍官方网站：Astro 静态生成，产物是纯静态 HTML，部署在现有域名根路径，/web/、/api/ 等业务路由保持不变",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "check:dist": "node scripts/check-dist.mjs",
    "check:release": "node scripts/check-release.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "capture:screens": "node scripts/capture-screens.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "make:og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "uqr": "0.1.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.2",
    "node-html-parser": "9.0.4",
    "puppeteer-core": "25.12.0",
    "typescript": "6.0.3"
  }
}
